<Window x:Class="Wordle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wordle"
        mc:Ignorable="d"
        Title="Wordle" Height="565" Width="850">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="270"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Label Content="Wordle" FontSize="72" Margin="20,0,0,0"/>
            <Label Content="Click on the Cards to guess!" FontSize="22" Margin="20,0,0,0"/>
        </StackPanel>
        <StackPanel x:Name="cards" Grid.Row="1" Orientation="Horizontal">

        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="New Word" Width="117" Height="58" Margin="20"/>
            <Button Content="Check" Width="117" Height="58" Margin="10,20,20,20"/>
        </StackPanel>
    </Grid>
</Window>
